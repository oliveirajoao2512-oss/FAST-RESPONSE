{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/cli/migrate.ts src/cli/create-admin.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist --out-extension:.js=.js && rm -rf dist/migrations && cp -r src/db/migrations dist/migrations",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "create-admin": "tsx src/cli/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
