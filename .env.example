# ---- Banco de dados (obrigatório)
# Com docker compose, só defina POSTGRES_PASSWORD; a DATABASE_URL é montada automaticamente.
POSTGRES_PASSWORD=troque-esta-senha
# Banco externo (ex.: Supabase, Session pooler). Se definido, o compose usa este banco em vez do serviço db.
EXTERNAL_DATABASE_URL=
DATABASE_URL=postgresql://fastresponse:troque-esta-senha@localhost:5432/fastresponse

# ---- Servidor
PORT=3000
# porta publicada pelo docker compose
HTTP_PORT=3000
APP_URL=http://localhost:3000
# true quando servido por HTTPS (recomendado em produção)
COOKIE_SECURE=false
SESSION_DAYS=7

# ---- Primeiro acesso: cria o administrador se não houver usuários
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Anexos
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# ---- Processos automáticos (vencimento, escalonamento, e-mails)
JOBS_ENABLED=true
JOB_INTERVAL_SECONDS=60

# ---- E-mail (SMTP corporativo). Sem SMTP_HOST, apenas notificações no sistema.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fast Response <fastresponse@suaempresa.com.br>
